{
	"name": "@snapwp/query",
	"version": "0.4.0",
	"license": "AGPL-3.0",
	"description": "Internal package for SnapWP",
	"author": "rtCamp",
	"type": "module",
	"engines": {
		"node": ">=22.0.0",
		"npm": ">=10.0.0",
		"yarn": "please-use-npm"
	},
	"files": [
		"dist"
	],
	"exports": {
		"import": "./dist/index.js",
		"require": "./dist/index.js",
		"types": "./dist/types/index.d.ts"
	},
	"scripts": {
		"build": "tsc --build",
		"postbuild": "npm run resolve-paths",
		"force-build": "tsc --build --force",
		"postforce-build": "npm run resolve-paths",
		"dev": "tsc-watch -b --onSuccess \"npm run resolve-paths\"",
		"resolve-paths": "resolve-tspaths",
		"codegen": "graphql-codegen --config codegen.ts",
		"codegen:watch": "graphql-codegen --config codegen.ts --watch",
		"lint": "eslint . --config ../../.eslintrc.json",
		"lint:fix": "eslint . --config ../../.eslintrc.json --fix",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@graphql-typed-document-node/core": "^3.2.0"
	},
	"peerDependencies": {
		"@apollo/client": "^3.11.4",
		"@snapwp/core": "^0.4.0",
		"graphql": "^16.9.0",
		"react": "^19.0.0"
	},
	"devDependencies": {
		"@graphql-codegen/cli": "^6.3.1",
		"@parcel/watcher": "^2.5.6",
		"@snapwp/codegen-config": "*",
		"@snapwp/types": "*",
		"@types/react": "*",
		"dotenv": "^17.4.2",
		"resolve-tspaths": "*",
		"tsc-watch": "*",
		"typescript": "*"
	}
}
